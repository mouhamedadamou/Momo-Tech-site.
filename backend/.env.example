# Copie ce fichier en .env et renseigne tes VRAIES valeurs.
# .env ne doit JAMAIS être commité sur Git (voir .gitignore).

# --- Serveur ---
PORT=4000
NODE_ENV=development
# Origine autorisée pour les appels CORS depuis le frontend
FRONTEND_ORIGIN=http://localhost:5500

# --- Base de données ---
DATABASE_FILE=./data/momo-tech.sqlite

# --- Authentification admin ---
# Génère une longue chaîne aléatoire, ex: `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- PayDunya ---
# "test" pendant le développement / Sandbox, "live" en production
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# Optionnel selon compte PayDunya
PAYDUNYA_PUBLIC_KEY=

# URL publique HTTPS que PayDunya doit appeler pour confirmer un paiement (IPN)
PAYDUNYA_CALLBACK_URL=https://votre-domaine.example.com/api/payments/ipn
# Page où le client revient après un paiement réussi
PAYDUNYA_RETURN_URL=https://votre-domaine.example.com/confirmation.html
# Page où le client revient s'il annule
PAYDUNYA_CANCEL_URL=https://votre-domaine.example.com/index.html

# Nom affiché sur la page de paiement PayDunya
STORE_NAME=Momo Tech
